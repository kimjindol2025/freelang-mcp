#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"

usage() {
  cat <<'EOF'
FreeLang Tools — 공용 개발 CLI

사용법:
  fl-tools start [경로]      작업 시작 컨텍스트·준비 상태 출력
  fl-tools review [경로]     수정 내용 전체 검토
  fl-tools deploy [경로]     검토된 프로젝트 배포 계약 실행
  fl-tools test             FreeLang deftest 테스트 실행
  fl-tools check            FreeLang 소스·테스트 검사
  fl-tools detect [경로]    FreeLang 계열 자동 판별
  fl-tools status [경로]    프로젝트·Git·테스트 상태 출력
  fl-tools route [경로]     프로젝트 작업 경로·명령 요약
  fl-tools doctor [경로]    프로젝트 건강검진
  fl-tools session <명령>   개발 세션·포트·로그 확인
  fl-tools journal <명령>   작업 저널 기록
  fl-tools release-check    릴리즈 준비 상태 검사
  fl-tools safe-push        원격 push 전 안전 검사
  fl-tools help             도움말
EOF
}

command_name="${1:-help}"
shift || true

case "$command_name" in
  start)
    exec "$ROOT/scripts/fl-start" "$@"
    ;;
  review)
    exec "$ROOT/scripts/fl-review" "$@"
    ;;
  deploy)
    exec "$ROOT/scripts/fl-deploy" "$@"
    ;;
  test)
    exec "$ROOT/scripts/fl-test" "$@"
    ;;
  check)
    exec "$ROOT/scripts/fl-check" "$@"
    ;;
  detect)
    exec "$ROOT/scripts/fl-detect" "$@"
    ;;
  status)
    exec "$ROOT/scripts/fl-status" "$@"
    ;;
  route|router)
    exec "$ROOT/scripts/fl-route" "$@"
    ;;
  doctor)
    exec "$ROOT/scripts/fl-doctor" "$@"
    ;;
  session)
    exec "$ROOT/scripts/fl-session" "$@"
    ;;
  journal)
    exec "$ROOT/scripts/fl-journal" "$@"
    ;;
  release-check)
    exec "$ROOT/scripts/fl-release-check" "$@"
    ;;
  safe-push)
    exec "$ROOT/scripts/fl-safe-push" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "알 수 없는 명령: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
