#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET_INPUT="${1:-.}"
shift || true
ROOT="$(cd -- "$TARGET_INPUT" && pwd -P)"

DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT")"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
DETECTED_RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"
RUNNER="${FREELANG_AFJ_RUNNER:-$DETECTED_RUNNER}"

if [[ "$DIALECT" != "AFJ" ]]; then
  echo "FREELANG_CHECK=DEFERRED"
  echo "DIALECT=$DIALECT"
  "$TOOLS_ROOT/scripts/fl-test" "$ROOT" "$@"
  exit 0
fi

if [[ ! -f "$RUNNER" ]]; then
  echo "FREELANG_CHECK=BLOCKED"
  echo "CAUSE=AFJ runner not found: $RUNNER" >&2
  exit 2
fi

SOURCE_LIST_FILE="$(mktemp)"
cleanup() { rm -f "$SOURCE_LIST_FILE"; }
trap cleanup EXIT INT TERM
if [[ -d "$ROOT/src" ]]; then
  find "$ROOT/src" -type f -name '*.fl' -print | sort > "$SOURCE_LIST_FILE"
else
  : > "$SOURCE_LIST_FILE"
fi
mapfile -t SOURCES < "$SOURCE_LIST_FILE"
for source in "${SOURCES[@]}"; do
  echo "[fl-check] $source"
  node "$RUNNER" check "$source"
done

"$TOOLS_ROOT/scripts/fl-test" "$ROOT" "$@"
echo "FREELANG_CHECK=PASS"
