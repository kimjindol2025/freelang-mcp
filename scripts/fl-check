#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
TARGET_INPUT="${1:-.}"
shift || true
ROOT="$(cd -- "$TARGET_INPUT" && pwd -P)"
RUNNER="${FREELANG_AFJ_RUNNER:-/home/kim/kim/platform/freelang-afj/bootstrap.js}"

DIALECT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT" | sed -n 's/^DIALECT=//p')"

if [[ "$DIALECT" != "AFJ" ]]; then
  echo "FREELANG_CHECK=DEFERRED"
  echo "DIALECT=$DIALECT"
  "$TOOLS_ROOT/scripts/fl-test" "$ROOT" "$@"
  exit 0
fi

if [[ ! -f "$RUNNER" ]]; then
  echo "FREELANG_CHECK=BLOCKED"
  echo "CAUSE=AFJ runner not found: $RUNNER" >&2
  exit 2
fi

mapfile -t SOURCES < <(find "$ROOT/src" -type f -name '*.fl' -print 2>/dev/null | sort)
for source in "${SOURCES[@]}"; do
  echo "[fl-check] $source"
  node "$RUNNER" check "$source"
done

"$TOOLS_ROOT/scripts/fl-test" "$ROOT" "$@"
echo "FREELANG_CHECK=PASS"
