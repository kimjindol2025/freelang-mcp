#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
TOOLS_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
MODE="auto"
case "${1:-}" in
  --v11|--afj|--auto)
    MODE="${1#--}"
    shift
    ;;
esac
TARGET_INPUT="${1:-.}"
shift || true
ROOT="$(cd -- "$TARGET_INPUT" && pwd -P)"
TEST_ROOT="${FREELANG_TEST_ROOT:-$ROOT/tests}"

resolve_v11_runner() {
  if [[ -n "${FREELANG_V11_BOOTSTRAP:-}" ]]; then
    printf '%s\n' "$FREELANG_V11_BOOTSTRAP"
    return
  fi
  if [[ -n "${FREELANG_V11_ROOT:-}" && -f "$FREELANG_V11_ROOT/bootstrap.js" ]]; then
    printf '%s\n' "$FREELANG_V11_ROOT/bootstrap.js"
    return
  fi
  for candidate in \
    "/root/freelang-v11/bootstrap.js" \
    "/root/freelang-surface-v0-clean-ek3qo2/v11/bootstrap.js"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  printf '%s\n' ""
}

resolve_afj_runner() {
  if [[ -n "${FREELANG_AFJ_RUNNER:-}" ]]; then
    printf '%s\n' "$FREELANG_AFJ_RUNNER"
    return
  fi
  if [[ -n "${FREELANG_AFJ_ROOT:-}" && -f "$FREELANG_AFJ_ROOT/bootstrap.js" ]]; then
    printf '%s\n' "$FREELANG_AFJ_ROOT/bootstrap.js"
    return
  fi
  for candidate in \
    "/root/lang/freelang-afj/bootstrap.js" \
    "/root/freelang-afj/bootstrap.js" \
    "/home/kim/kim/platform/freelang-afj/bootstrap.js"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  printf '%s\n' "/home/kim/kim/platform/freelang-afj/bootstrap.js"
}

EXPLICIT_TEST_LIST_FILE=""
EXPLICIT_OUTPUT_FILE=""
cleanup_explicit() {
  [[ -z "${EXPLICIT_TEST_LIST_FILE:-}" ]] || rm -f -- "$EXPLICIT_TEST_LIST_FILE"
  [[ -z "${EXPLICIT_OUTPUT_FILE:-}" ]] || rm -f -- "$EXPLICIT_OUTPUT_FILE"
}

run_explicit_suite() {
  local kind="$1"
  local runner="$2"
  local marker="FREELANG_${kind}_TEST"
  local test_list_file
  local output_file=""

  if [[ -z "$runner" || ! -f "$runner" ]]; then
    echo "$marker=BLOCKED"
    echo "FREELANG_TEST=BLOCKED"
    echo "CAUSE=${kind} runner not found: ${runner:-<unset>}" >&2
    return 2
  fi
  if [[ ! -d "$TEST_ROOT" ]]; then
    echo "$marker=NO_TESTS"
    echo "FREELANG_TEST=NO_TESTS"
    return 0
  fi

  test_list_file="$(mktemp)"
  EXPLICIT_TEST_LIST_FILE="$test_list_file"
  trap cleanup_explicit EXIT INT TERM
  find "$TEST_ROOT" -type f -name '*.test.fl' -print | sort > "$test_list_file"
  mapfile -t TEST_FILES < "$test_list_file"
  if [[ "${#TEST_FILES[@]}" -eq 0 ]]; then
    echo "$marker=NO_TESTS"
    echo "FREELANG_TEST=NO_TESTS"
    return 0
  fi

  for test_file in "${TEST_FILES[@]}"; do
    local relative="${test_file#"$ROOT/"}"
    echo "[fl-test:$kind] check $relative"
    if ! node "$runner" check "$test_file"; then
      echo "$marker=FAIL"
      echo "FREELANG_TEST=FAIL"
      return 1
    fi

    rm -f "$output_file"
    output_file="$(mktemp)"
    EXPLICIT_OUTPUT_FILE="$output_file"
    echo "[fl-test:$kind] run $relative"
    if ! node "$runner" run "$test_file" >"$output_file" 2>&1; then
      cat "$output_file"
      echo "$marker=FAIL"
      echo "FREELANG_TEST=FAIL"
      return 1
    fi
    cat "$output_file"
    summary_line="$(grep -E '^Test Results: [0-9]+/[0-9]+ passed$' "$output_file" | tail -n 1 || true)"
    passed="${summary_line#Test Results: }"
    passed="${passed%%/*}"
    total="${summary_line#*/}"
    total="${total% passed}"
    if [[ -z "$summary_line" || "$passed" != "$total" ]] || grep -q 'FAILED' "$output_file"; then
      echo "[fl-test:$kind] missing passing summary: $relative" >&2
      echo "$marker=FAIL"
      echo "FREELANG_TEST=FAIL"
      return 1
    fi
  done

  echo "$marker=PASS"
  echo "FREELANG_TEST=PASS"
  return 0
}

case "$MODE" in
  v11)
    run_explicit_suite "V11" "$(resolve_v11_runner)"
    exit $?
    ;;
  afj)
    run_explicit_suite "AFJ" "$(resolve_afj_runner)"
    exit $?
    ;;
esac

DETECT_OUTPUT="$($TOOLS_ROOT/scripts/fl-detect "$ROOT")"
DIALECT="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^DIALECT=//p')"
DETECTED_RUNNER="$(printf '%s\n' "$DETECT_OUTPUT" | sed -n 's/^RUNNER=//p')"
if [[ "$DIALECT" == "AFJ" && -z "${FREELANG_AFJ_RUNNER:-}" && "$DETECTED_RUNNER" == "$ROOT/bootstrap.js" ]]; then
  DETECTED_RUNNER=""
fi
RUNNER="${FREELANG_AFJ_RUNNER:-$DETECTED_RUNNER}"

case "$DIALECT" in
  FRONT)
    FRONT_BUILD="$ROOT/fl-front-build.js"
    FRONT_DIR="$ROOT"
    if [[ ! -f "$FRONT_BUILD" && -f "$ROOT/web/fl-front-build.js" ]]; then
      FRONT_BUILD="$ROOT/web/fl-front-build.js"
      FRONT_DIR="$ROOT/web"
    fi
    if [[ -f "$FRONT_BUILD" ]]; then
      (cd "$FRONT_DIR" && FL_GIT_REPO="${FL_GIT_REPO:-$ROOT}" node fl-front-build.js)
      echo "FREELANG_TEST=PASS"
      exit 0
    fi
    ;;
  SCRIPT)
    SCRIPT_RUNNER="${FREELANG_SCRIPT_RUNNER:-$DETECTED_RUNNER}"
    SCRIPT_TEST_COUNT=0
    [[ -d "$TEST_ROOT" ]] && SCRIPT_TEST_COUNT="$(find "$TEST_ROOT" -type f -name '*.test.fls' -print 2>/dev/null | wc -l | tr -d ' ')"
    AFJ_TEST_COUNT=0
    [[ -d "$TEST_ROOT" ]] && AFJ_TEST_COUNT="$(find "$TEST_ROOT" -type f -name '*.test.fl' -print 2>/dev/null | wc -l | tr -d ' ')"
    if [[ "$SCRIPT_TEST_COUNT" -gt 0 && -f "$SCRIPT_RUNNER" ]]; then
      node "$SCRIPT_RUNNER" test "$TEST_ROOT" --allow-listed "$@"
      echo "FREELANG_SCRIPT_TEST=PASS"
    elif [[ "$SCRIPT_TEST_COUNT" -gt 0 ]]; then
      echo "FREELANG_TEST=BLOCKED"
      echo "CAUSE=Script runner not found: $SCRIPT_RUNNER" >&2
      exit 2
    fi
    if [[ "$AFJ_TEST_COUNT" -eq 0 ]]; then
      [[ "$SCRIPT_TEST_COUNT" -gt 0 ]] && { echo "FREELANG_TEST=PASS"; exit 0; }
      echo "FREELANG_TEST=NO_TESTS"
      exit 0
    fi
    if [[ -n "${FREELANG_AFJ_RUNNER:-}" ]]; then
      RUNNER="$FREELANG_AFJ_RUNNER"
    elif [[ -f "/root/lang/freelang-afj/bootstrap.js" ]]; then
      RUNNER="/root/lang/freelang-afj/bootstrap.js"
    elif [[ -f "/root/freelang-afj/bootstrap.js" ]]; then
      RUNNER="/root/freelang-afj/bootstrap.js"
    else
      RUNNER="/home/kim/kim/platform/freelang-afj/bootstrap.js"
    fi
    ;;
  AIA)
    if [[ -x "$ROOT/tools/verify-aia-cold-boot.sh" ]]; then
      "$ROOT/tools/verify-aia-cold-boot.sh"
      echo "FREELANG_TEST=PASS"
      exit 0
    fi
    ;;
  FX)
    if [[ -x "$ROOT/tests/run-tests.sh" ]]; then
      (cd "$ROOT" && ./tests/run-tests.sh)
      echo "FREELANG_TEST=PASS"
      exit 0
    fi
    ;;
esac

if [[ ! -f "$RUNNER" ]]; then
  echo "FREELANG_TEST=BLOCKED"
  echo "CAUSE=AFJ runner not found: $RUNNER" >&2
  exit 2
fi

if [[ ! -d "$TEST_ROOT" ]]; then
  echo "FREELANG_TEST=NO_TESTS"
  exit 0
fi

TEST_LIST_FILE="$(mktemp)"
OUTPUT_FILE=""
cleanup() {
  rm -f "$TEST_LIST_FILE" "$OUTPUT_FILE"
}
trap cleanup EXIT INT TERM
find "$TEST_ROOT" -type f -name '*.test.fl' -print | sort > "$TEST_LIST_FILE"
mapfile -t TEST_FILES < "$TEST_LIST_FILE"

if [[ "${#TEST_FILES[@]}" -eq 0 ]]; then
  echo "FREELANG_TEST=NO_TESTS"
  exit 0
fi

for test_file in "${TEST_FILES[@]}"; do
  relative="${test_file#"$ROOT/"}"
  echo "[fl-test] check $relative"
  node "$RUNNER" check "$test_file"

  rm -f "$OUTPUT_FILE"
  OUTPUT_FILE="$(mktemp)"
  echo "[fl-test] run $relative"
  if ! node "$RUNNER" run "$test_file" >"$OUTPUT_FILE" 2>&1; then
    cat "$OUTPUT_FILE"
    echo "FREELANG_TEST=FAIL"
    exit 1
  fi
  cat "$OUTPUT_FILE"
  SUMMARY_LINE="$(grep -E '^Test Results: [0-9]+/[0-9]+ passed$' "$OUTPUT_FILE" | tail -n 1 || true)"
  PASSED="${SUMMARY_LINE#Test Results: }"
  PASSED="${PASSED%%/*}"
  TOTAL="${SUMMARY_LINE#*/}"
  TOTAL="${TOTAL% passed}"
  if [[ -z "$SUMMARY_LINE" || "$PASSED" != "$TOTAL" ]] || grep -q 'FAILED' "$OUTPUT_FILE"; then
    echo "[fl-test] missing passing summary: $relative" >&2
    echo "FREELANG_TEST=FAIL"
    exit 1
  fi
done

echo "FREELANG_TEST=PASS"
